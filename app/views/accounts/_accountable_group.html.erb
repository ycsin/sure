<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, sortable: false, **args) %>

<% copy = account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>
<div id="<%= copy %>" data-group-key="<%= account_group.key %>">
  <%# With manual ordering the rows stay flat, as reordering works on single rows. %>
  <% entries = sortable ? account_group.accounts : account_group.sidebar_entries(order: Current.user&.account_order, institution_groups: Current.family.institution_group_settings) %>
  <% active_bundle = entries.any? { |entry| entry.is_a?(BalanceSheet::AccountGroup::InstitutionBundle) && entry.slug == sidebar_active_institution_group_slug } %>
  <% is_open = open.nil? ? (active_bundle || account_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key)) : open %>
  <%= render DS::Disclosure.new(align: :left, open: is_open) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center gap-3">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>
        <%= tag.span class: class_names("text-sm text-primary font-medium", "animate-pulse" => account_group.syncing?) do %>
          <%= account_group.name %>
        <% end %>
      </div>

      <div class="ml-auto text-right grow">
        <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary privacy-sensitive" %>
        <% group_version = sidebar_sparkline_versions(Current.family)[account_group.accountable_type] %>
        <%= tag.div id: sidebar_sparkline_wrapper_id(copy, "total", group_version), data: kept_element_data do %>
          <%= turbo_frame_tag "#{account_group.key}_sparkline",
                              src: accountable_sparkline_path(account_group.key, v: group_version),
                              loading: "lazy",
                              data: sparkline_frame_data do %>
            <div class="flex items-center w-8 h-4 ml-auto">
              <div class="w-6 h-px bg-loader"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= tag.div class: "space-y-1",
          data: sortable ? {
            controller: "sortable-list",
            sortable_list_url_value: reorder_accounts_path(group: account_group.key),
            sortable_list_param_value: "account_ids",
            sortable_list_hold_delay_value: 400,
            sortable_list_save_timeout_value: 10_000,
            sortable_list_mirror_lists_value: true,
            action: "dragover->sortable-list#dragOver drop->sortable-list#drop account-sort-mode:stop@window->sortable-list#releaseKeyboardGrab turbo:before-visit@window->sortable-list#saveBeforeVisit"
          } : {} do %>
      <% entries.each do |entry| %>
        <% if entry.is_a?(BalanceSheet::AccountGroup::InstitutionBundle) %>
          <%= render "accounts/sidebar_institution_bundle", bundle: entry, account_group: account_group, mobile: mobile, all_tab: all_tab %>
        <% else %>
          <%= render "accounts/sidebar_account_row", account: entry, account_group: account_group, copy: copy, sortable: sortable %>
        <% end %>
      <% end %>
    <% end %>

    <div class="my-2">
      <%= render DS::Link.new(
      href: new_polymorphic_path(account_group.key, step: "method_select"),
      text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
      icon: "plus",
      full_width: true,
      variant: "ghost",
      frame: :modal,
      class: "justify-start"
    ) %>
    </div>
  <% end %>
</div>
