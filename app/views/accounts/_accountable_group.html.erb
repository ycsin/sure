<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, sortable: false, reconciliation_indicators: {}, **args) %>

<% copy = account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>
<div id="<%= copy %>" data-group-key="<%= account_group.key %>">
  <% entries = sidebar_group_entries(account_group, sortable: sortable) %>
  <% is_open = sidebar_group_open?(account_group, entries, open: open) %>
  <%= render DS::Disclosure.new(align: :left, open: is_open) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <%# The name gives way (truncating) to the total, so a long group name
          can't push the total out of line at a narrow sidebar width; the
          title shows the full name on hover. With no hover (a touch screen)
          or with keyboard focus, a cut name slides once to show its end
          (sidebar_name_marquee_controller). With reduced motion the name
          keeps its full width there instead, and a total that no longer
          fits moves to the line below, still on the right. %>
      <div class="flex items-center w-full min-w-0 gap-x-2 pointer-coarse:motion-reduce:flex-wrap [summary:focus-visible_&]:motion-reduce:flex-wrap">
        <div class="flex items-center gap-3 min-w-0 pointer-coarse:motion-reduce:shrink-0 pointer-coarse:motion-reduce:max-w-full [summary:focus-visible_&]:motion-reduce:shrink-0 [summary:focus-visible_&]:motion-reduce:max-w-full">
          <%= icon "chevron-right", class: "shrink-0 group-open:transform group-open:rotate-90" %>
          <%= tag.span class: class_names("text-sm text-primary font-medium truncate pointer-coarse:motion-reduce:whitespace-normal [summary:focus-visible_&]:motion-reduce:whitespace-normal", "animate-pulse" => account_group.syncing?),
                title: account_group.name,
                data: { controller: "sidebar-name-marquee" } do %>
            <%= tag.span account_group.name, data: { sidebar_name_marquee_target: "text" } %>
          <% end %>
        </div>

        <div class="ml-auto text-right shrink-0">
          <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
          <% group_version = sidebar_sparkline_versions(Current.family)[account_group.accountable_type] %>
          <%= tag.div id: sidebar_sparkline_wrapper_id(copy, "total", group_version), data: kept_element_data do %>
            <%= turbo_frame_tag "#{account_group.key}_sparkline",
                                src: accountable_sparkline_path(account_group.key, v: group_version),
                                loading: "lazy",
                                data: sparkline_frame_data do %>
              <div class="flex items-center w-8 h-4 ml-auto">
                <div class="w-6 h-px bg-loader"></div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= tag.div class: "space-y-1",
          data: sortable ? {
            controller: "sortable-list",
            sortable_list_url_value: reorder_accounts_path(group: account_group.key),
            sortable_list_param_value: "account_ids",
            sortable_list_hold_delay_value: 400,
            sortable_list_save_timeout_value: 10_000,
            sortable_list_mirror_lists_value: true,
            action: "dragover->sortable-list#dragOver drop->sortable-list#drop account-sort-mode:stop@window->sortable-list#releaseKeyboardGrab turbo:before-visit@window->sortable-list#saveBeforeVisit"
          } : {} do %>
      <% entries.each do |entry| %>
        <% if entry.is_a?(BalanceSheet::AccountGroup::InstitutionBundle) %>
          <%= render "accounts/sidebar_institution_bundle", bundle: entry, account_group: account_group, mobile: mobile, all_tab: all_tab, reconciliation_indicators: reconciliation_indicators %>
        <% else %>
          <%= render "accounts/sidebar_account_row", account: entry, account_group: account_group, copy: copy, sortable: sortable, reconciliation_indicator: reconciliation_indicators[entry.id] %>
        <% end %>
      <% end %>
    <% end %>

    <div class="my-2">
      <%= render DS::Link.new(
      href: new_polymorphic_path(account_group.key, step: "method_select"),
      text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
      icon: "plus",
      full_width: true,
      variant: "ghost",
      frame: :modal,
      class: "justify-start"
    ) %>
    </div>
  <% end %>
</div>
