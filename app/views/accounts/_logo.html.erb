<%# locals: (account:, size: "md", color: nil, url: account.logo_url, name: account.name, reconciliation_indicator: nil) %>

<% size_classes = {
  "sm" => "w-6 h-6",
  "md" => "w-9 h-9",
  "lg" => "w-10 h-10",
  "full" => "w-full h-full"
} %>

<% initials = {
  variant: :text,
  hex_color: color || account.accountable&.color,
  text: name.to_s,
  size: size,
  rounded: true
} %>

<%# A sidebar logo sits in a wrapper Turbo carries across visits; a failed
    image must not be carried as its initials, so it drops the permanence
    and the next page tries the image again. %>
<%# Before that, a same-origin image retries once at a fresh URL: iOS Safari
    can fail an image it only revalidated (its cached redirect, then 304 Not
    Modified, with the cached copy already dropped), and a new URL makes it
    fetch the image again rather than give up on a logo that is there.
    window.URL: in an inline handler a bare URL is document.URL, a string. %>
<% retry_once = "if (!this.dataset.retried && new window.URL(this.src).origin === location.origin) { this.dataset.retried = '1'; const url = new window.URL(this.src); url.searchParams.set('retry', Date.now()); this.src = url; return; }" %>
<% on_error = "#{retry_once} this.closest('[data-turbo-permanent]')?.removeAttribute('data-turbo-permanent'); #{ProviderLogo::REMOVE_ON_ERROR}" %>
<div class="relative shrink-0">
  <% if url.present? %>
    <%# The ProviderLogo recipe: the initials sit under the image, and a logo the
        browser cannot show (an upload whose file is gone, a dead favicon or
        Brandfetch URL) removes itself to reveal them. %>
    <%= tag.span class: "relative block shrink-0 #{size_classes[size]}" do %>
      <%= render DS::FilledIcon.new(**initials, class_name: "absolute inset-0 w-full! h-full!") %>
      <%= image_tag url,
            class: "absolute inset-0 w-full h-full rounded-full object-contain bg-container",
            alt: "",
            loading: "lazy",
            onerror: on_error %>
    <% end %>
  <% else %>
    <%= render DS::FilledIcon.new(**initials) %>
  <% end %>

  <% if reconciliation_indicator.present? %>
    <%= render "accounts/reconciliation_indicator", indicator: reconciliation_indicator, html_class: "absolute -bottom-0.5 -right-0.5" %>
  <% end %>
</div>
