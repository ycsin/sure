<%# locals: (bundle:, account_group:, mobile: false, all_tab: false) %>
<%# Several accounts at one institution: one row with the institution's icon,
    name and combined total, leading to their page, and a chevron opening
    onto the accounts, indented under it. A link inside <summary> navigates
    without toggling it, so only the chevron opens and closes the row. %>
<% bundle_path = institution_group_path(bundle) %>
<% active = page_active?(bundle_path) %>
<% open = active || bundle.accounts.any? { |account| page_active?(account_path(account)) } %>
<%= tag.details id: bundle.dom_id(account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile)),
                open: open,
                class: "group/bundle",
                data: { institution_bundle: bundle.key } do %>
  <summary class="flex items-center gap-1 rounded-lg cursor-pointer list-none [&::-webkit-details-marker]:hidden"
           title="<%= t("accounts.sidebar.institution_bundle_title", institution: bundle.name, count: bundle.accounts.size) %>">
    <%= link_to bundle_path,
          class: class_names(
            "flex items-center gap-2 px-3 py-2 rounded-lg min-w-0 grow",
            active ? "bg-container" : "hover:bg-surface-hover"
          ),
          data: active ? { active_account: true } : {} do %>
      <% logo_key = Digest::MD5.hexdigest([ bundle.logo_url, bundle.name, account_group.color ].join("|"))[0, 12] %>
      <%= tag.span id: "logo_keep_#{bundle.dom_id(account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile))}_#{logo_key}", class: "shrink-0", data: kept_element_data do %>
        <%= render "accounts/logo", account: bundle.logo_account, url: bundle.logo_url, name: bundle.name, size: "sm", color: account_group.color %>
      <% end %>

      <div class="min-w-0 grow">
        <%= tag.p bundle.name, class: class_names("text-sm text-primary font-medium truncate", "animate-pulse" => bundle.syncing?) %>
        <p class="text-sm text-secondary truncate"><%= t("accounts.sidebar.institution_accounts", count: bundle.accounts.size) %></p>
      </div>

      <div class="ml-auto text-right shrink-0">
        <%= tag.p format_money(bundle.total_money), class: "text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
      </div>
    <% end %>

    <span class="shrink-0 p-2 rounded-lg text-secondary hover:bg-surface-hover" data-institution-bundle-toggle>
      <%= icon "chevron-down", size: "sm", class: "transition-transform group-open/bundle:rotate-180" %>
      <span class="sr-only"><%= t("accounts.sidebar.institution_bundle_toggle", institution: bundle.name) %></span>
    </span>
  </summary>

  <div class="ml-6 pl-2 border-l border-secondary space-y-1 mt-1">
    <% bundle.accounts.each do |account| %>
      <%= render "accounts/sidebar_account_row", account: account, account_group: account_group, copy: account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile), show_logo: false %>
    <% end %>
  </div>
<% end %>
