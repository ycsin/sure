<% content_for :title, t("tricount_items.select_existing_account.title") %>

<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("tricount_items.select_existing_account.header")) do %>
    <div class="flex items-center gap-2">
      <%= icon "link", class: "text-primary" %>
      <span class="text-primary"><%= t("tricount_items.select_existing_account.subtitle", account_name: @account.name) %></span>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <% if @tricount_accounts.blank? %>
      <div class="text-center py-8">
        <%= icon "alert-circle", class: "text-warning mx-auto mb-4", size: "lg" %>
        <p class="text-secondary"><%= t("tricount_items.select_existing_account.no_accounts") %></p>
        <p class="text-sm text-secondary mt-2"><%= t("tricount_items.select_existing_account.connect_hint") %></p>
        <%= link_to t("tricount_items.select_existing_account.settings_link"), settings_providers_path, class: "btn btn--primary btn--sm mt-4" %>
      </div>
    <% else %>
      <div class="space-y-4">
        <div class="bg-surface border border-primary p-4 rounded-lg mb-4">
          <p class="text-sm text-primary">
            <strong><%= t("tricount_items.select_existing_account.linking_to") %></strong>
            <%= @account.name %>
          </p>
        </div>

        <% @tricount_accounts.each do |tricount_account| %>
          <%= form_with url: link_existing_account_tricount_items_path,
                        method: :post,
                        local: true,
                        data: { turbo_frame: "_top" },
                        class: "border border-primary rounded-lg p-4 hover:bg-surface transition-colors" do |form| %>
            <%= hidden_field_tag :account_id, @account.id %>
            <%= hidden_field_tag :tricount_account_id, tricount_account.id %>

            <div class="flex items-end justify-between gap-3">
              <div class="flex-1 min-w-0">
                <h4 class="font-medium text-primary truncate"><%= tricount_account.name %></h4>
                <%= label_tag dom_id(tricount_account, :existing_member), t("tricount_items.setup_accounts.member_label"), class: "block text-xs text-secondary mt-2 mb-1" %>
                <%= select_tag :member_uuid,
                               options_for_select(tricount_account.members.map { |member| [ member.name, member.uuid ] }, tricount_account.member_uuid),
                               include_blank: t("tricount_items.setup_accounts.member_prompt"),
                               required: true,
                               id: dom_id(tricount_account, :existing_member),
                               class: "form-field__input w-full" %>
              </div>
              <%= render DS::Button.new(
                text: t("tricount_items.select_existing_account.link_button"),
                variant: "primary",
                size: "sm",
                type: "submit"
              ) %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="mt-6">
        <%= render DS::Link.new(
          text: t("tricount_items.select_existing_account.cancel_button"),
          variant: "secondary",
          href: account_path(@account)
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
